# Copy to .env. A provider is enabled when its key is present.
IMAGINATOR_DATA_DIR=./data
IMAGINATOR_PORT=4747
IMAGINATOR_GLOBAL_CONCURRENCY=8
# Set to 1 to enable the mock provider (always on when no real provider keys are set)
IMAGINATOR_MOCK=1
OPENAI_API_KEY=
# Optional: proxy or compatible endpoint for the OpenAI Images API
# OPENAI_BASE_URL=https://api.openai.com/v1
BFL_API_KEY=
FAL_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
